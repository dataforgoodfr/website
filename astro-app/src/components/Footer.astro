---
import { getLangFromUrl, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);

const communityNav = {
  github: 'https://github.com/dataforgoodfr',
  youtube: 'https://www.youtube.com/channel/UCA_utdbmVhAOFujulWlaaCQ?themeRefresh=1',
  meetup: 'https://www.meetup.com/data-for-good-fr/',
};

const informationsNav = {
  faq: translatePath('/faq'),
  cgu: translatePath('/cgu'),
  charte: translatePath('/charte'),
};
---

<footer class="relative">
  <img src="/images/scratch.svg" alt="" width="212" height="48" class="absolute bottom-full left-0 object-contain w-full" />
  
  <div class="py-16 bg-white text-black">
    <div class="container grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-x-4 gap-y-12 mx-auto px-4">
      <!-- Logo and description -->
      <div class="space-y-5">
        <a href={translatePath('/')}>
          <img
            src="/images/dataforgood.svg"
            alt="Data for Good France"
            width="212"
            height="48"
            class="object-contain"
          />
        </a>

        <p class="font-secondary max-w-52">
          Data for Good France est une association qui promeut l'utilisation de la data pour l'intérêt général.
        </p>
      </div>

      <!-- Community navigation -->
      <nav aria-labelledby="footer-community-nav" class="flex flex-col gap-5 text-sm">
        <p id="footer-community-nav" class="h4-like font-bold">Communauté</p>
        <ul class="space-y-5">
          {Object.entries(communityNav).map(([key, href]) => (
            <li key={key}>
              <a 
                href={href} 
                target="_blank" 
                rel="noreferrer" 
                class="text-black/60 underline hover:no-underline"
              >
                {key === 'github' && 'GitHub'}
                {key === 'youtube' && 'YouTube'}
                {key === 'meetup' && 'Meetup'}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Information navigation -->
      <nav aria-labelledby="footer-informations-nav" class="flex flex-col gap-5 text-sm">
        <p id="footer-informations-nav" class="h4-like font-bold">Informations</p>
        <ul class="space-y-5">
          {Object.entries(informationsNav).map(([key, href]) => (
            <li key={key}>
              <a 
                href={href} 
                class="text-black/60 underline hover:no-underline"
              >
                {key === 'faq' && 'FAQ'}
                {key === 'cgu' && 'CGU'}
                {key === 'charte' && 'Charte'}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Contact and social -->
      <div class="flex flex-col gap-5 text-sm">
        <p class="h4-like font-bold">Contact</p>
        <p>
          <a 
            href="mailto:contact@dataforgood.fr" 
            class="inline-block bg-gray-100 text-black px-4 py-2 rounded hover:bg-gray-200 transition-colors"
          >
            contact@dataforgood.fr
          </a>
        </p>
        <ul class="flex gap-2">
          <li>
            <a 
              href="https://bsky.app/profile/dataforgood.fr" 
              target="_blank" 
              rel="noreferrer"
              class="w-10 h-10 bg-black text-white rounded-full flex items-center justify-center hover:bg-gray-800 transition-colors"
              aria-label="Bluesky"
            >
              <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                <path d="M2.5 8C5 5.5 7 3.5 8 3.5S11 5.5 13.5 8C11 10.5 9 12.5 8 12.5S5 10.5 2.5 8Z"/>
              </svg>
            </a>
          </li>
          <li>
            <a 
              href="https://www.linkedin.com/company/dataforgoodfr/" 
              target="_blank" 
              rel="noreferrer"
              class="w-10 h-10 bg-black text-white rounded-full flex items-center justify-center hover:bg-gray-800 transition-colors"
              aria-label="LinkedIn"
            >
              <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                <path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.248V6.169H2.542v7.225h2.401zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016a5.54 5.54 0 0 1 .016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4z"/>
              </svg>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Copyright -->
    <div class="container flex flex-wrap gap-8 mx-auto px-4 mt-10 lg:mt-36 text-xs text-black/60">
      <p>
        © Data for Good France {new Date().getFullYear()}
      </p>
      <p>
        Site créé par 
        <a 
          href="https://coucou.design/" 
          target="_blank" 
          rel="noreferrer" 
          class="underline hover:no-underline ml-1"
        >
          Coucou Design
        </a>
      </p>
    </div>
  </div>
</footer>