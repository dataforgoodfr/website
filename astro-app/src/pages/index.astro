---
import Layout from '../layouts/Layout.astro';
import client from '../lib/strapi-client';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Data fetching in Astro frontmatter
const { data } = await client.GET('/home-page', {
  params: {
    query: {
      populate: {
        seo_meta: {
          populate: "*"
        },
        hero: {
          populate: "*"
        },
        results: {
          populate: {
            kpi: {
              populate: "*",
            },
            cta: {
              populate: "*",
            }
          }
        },
        featured_projects: {
          fields: ["title", "short_description", "slug"],
          populate: "thumbnail"
        },
        thematics: {
          populate: "*"
        },
        events: {
          populate: "*"
        },
        resources: {
          populate: {
            blog: {
              populate: {
                author: {
                  fields: ["name"]
                },
                thumbnail: {
                  fields: ["url"]
                }
              }
            },
            press_release: {
              populate: "*"
            }
          }
        }
      }
    }
  }
});

if (!data?.data) {
  return Astro.redirect('/404');
}
---

<Layout>
  <section class="container mx-auto px-4 py-8">
    <h1 class="text-4xl font-bold mb-6">Data for Good France</h1>
    <p class="text-xl mb-8">Utilisons la data pour l'intérêt général</p>
    
    {data.data.hero?.image?.url && (
      <img 
        src={data.data.hero.image.url} 
        alt={data.data.hero.title || 'DataForGood'}
        class="w-full h-96 object-cover rounded-lg shadow-lg mb-8"
      />
    )}
    
    {data.data.project_carousel_title && (
      <h2 class="text-3xl font-bold mb-6">{data.data.project_carousel_title}</h2>
    )}
    
    {data.data.featured_projects && data.data.featured_projects.length > 0 && (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
        {data.data.featured_projects.map((project) => (
          <div class="bg-white rounded-lg shadow-md overflow-hidden">
            {project.thumbnail?.url && (
              <img 
                src={project.thumbnail.url} 
                alt={project.title || ''}
                class="w-full h-48 object-cover"
              />
            )}
            <div class="p-6">
              <h3 class="text-xl font-semibold mb-2">{project.title}</h3>
              <p class="text-gray-600 mb-4">{project.short_description}</p>
              <a 
                href={`/projets/${project.slug}`}
                class="inline-block bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 transition-colors"
              >
                Voir le projet
              </a>
            </div>
          </div>
        ))}
      </div>
    )}
  </section>
</Layout>